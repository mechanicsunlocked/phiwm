# yaml-language-server: $schema=https://aka.ms/winget-manifest.defaultLocale.1.10.0.schema.json
PackageIdentifier: @ID@
PackageVersion: @VERSION@
PackageLocale: en-US
Publisher: @PUBLISHER@
PublisherUrl: @REPO_URL@
PublisherSupportUrl: @REPO_URL@/issues
PackageName: phiwm
PackageUrl: @REPO_URL@
License: MIT
LicenseUrl: @REPO_URL@/blob/main/LICENSE
ShortDescription: Dwindle tiling window manager for Windows 11, halves clockwise, nothing to configure.
Description: |-
  phiwm halves the screen, clockwise: every new window takes half of the least-split
  window, up to eight per workspace. One layout, one set of keys, no config file: workspaces
  1-10 per monitor, focus follows the mouse, native Windows 11 border colors, and a single
  small exe with no services or helper daemons.
Tags:
- tiling
- tiling-window-manager
- window-manager
- hyprland
- dwindle
- keyboard
ReleaseNotesUrl: @REPO_URL@/releases/tag/v@VERSION@
ManifestType: defaultLocale
